PORT=5000
NODE_ENV=development

# MongoDB Atlas - thay <username>, <password>, <cluster> bang thong tin cua ban
# Luu y: phai co /homestay_booking truoc dau ? (ten database)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.xxxxx.mongodb.net/homestay_booking?retryWrites=true&w=majority

# Neu chay MongoDB local thi dung dong duoi thay cho dong tren
# MONGODB_URI=mongodb://127.0.0.1:27017/homestay_booking

# Google OAuth - cung Client ID voi AUTH_GOOGLE_ID ben client
GOOGLE_CLIENT_ID=

JWT_SECRET=doi_chuoi_nay_thanh_chuoi_bi_mat_cua_ban
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
